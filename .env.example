# Warframe Helper - Environment Configuration

# Port to expose on host
PORT=3000

# Host IP to bind to:
# Use 127.0.0.1 if sitting behind a local reverse proxy (Nginx, Caddy, Traefik)
# Use 0.0.0.0 to expose directly on LAN / WireGuard VPN subnet
HOST_BIND_IP=0.0.0.0

# Directory for SQLite database persistence
DATA_DIR=/app/data

# Environment mode
NODE_ENV=production
