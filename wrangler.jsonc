{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tennolink",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tennolink-db",
      "database_id": "<INSERT_YOUR_D1_DATABASE_ID_HERE>"
    }
  ]
}
