# Cloudflare Assets Ignore
# Exclude root backend files, node_modules, and git directories from static assets upload

node_modules/
.git/
.github/
.wrangler/
/companion/
/server/
/data/
/Dockerfile
/docker-compose.yml
/.dockerignore
/.env*
/docs/
/scripts/

# Explicitly ensure frontend assets are always included
!src/**
!public/**
